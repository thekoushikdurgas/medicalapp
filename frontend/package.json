{
  "name": "pharmacy-fantasy-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 0.0.0.0 --port 3000",
    "build": "next build",
    "start": "next start -H 0.0.0.0 --port 3000",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,json,css}\"",
    "clean": "node -e \"['.next','out','dist'].forEach((p)=>require('fs').rmSync(p,{recursive:true,force:true}))\"",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage",
    "css:inventory": "node scripts/css-inventory.mjs",
    "codegen": "graphql-codegen --config codegen.ts",
    "codegen:local": "graphql-codegen --config codegen.local.ts",
    "check:best-practices": "node scripts/check-best-practices.mjs"
  },
  "dependencies": {
    "@apollo/client": "^3.11.0",
    "graphql": "^16.9.0",
    "lucide-react": "^1.59.0",
    "next": "^14.2.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^7.4.6",
    "@graphql-codegen/typescript": "^6.1.2",
    "@graphql-codegen/typescript-operations": "^6.1.10",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.0",
    "prettier": "^3.9.10",
    "typescript": "^5.6.0",
    "vitest": "^5.0.5"
  }
}
