# ============================================================
# Pharmacy Fantasy Backend — Environment Variables
# ============================================================

# ── General ──────────────────────────────────────────────────
APP_NAME=PharmacyFantasy
APP_ENV=development
DEBUG=true

# ── Backend (FastAPI) ────────────────────────────────────────
BACKEND_PORT=8000
SECRET_KEY=change-me-to-a-random-64-char-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Database (PostgreSQL or SQLite) ───────────────────────────
# PostgreSQL:
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/pharmacyfantasy
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=pharmacyfantasy
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# SQLite (Zero-dependency local dev alternative):
# DATABASE_URL=sqlite+aiosqlite:///./pharmacyfantasy.db

# ── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── CORS ─────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000","http://13.223.50.113:3000","http://13.223.50.113","http://localhost"]

# ── File Storage (Invoice PDFs, Images) ──────────────────────
STORAGE_BACKEND=local

# ── GST Configuration ───────────────────────────────────────
DEFAULT_SGST_RATE=2.5
DEFAULT_CGST_RATE=2.5
COMPANY_GSTIN=19BKMPG6092H1ZO
COMPANY_NAME=MAA ESWARI PHARMACEUTICALS
COMPANY_ADDRESS=BENACHITY, DURGAPUR-13, WEST BENGAL
COMPANY_PHONE=9614081313
