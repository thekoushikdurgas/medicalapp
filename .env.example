# ============================================================
# Pharmacy Fantasy — Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# ── General ──────────────────────────────────────────────────
APP_NAME=PharmacyFantasy
APP_ENV=development
DEBUG=true

# ── Backend (FastAPI) ────────────────────────────────────────
BACKEND_PORT=8000
SECRET_KEY=change-me-to-a-random-64-char-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Database (PostgreSQL) ────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/pharmacyfantasy
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=pharmacyfantasy
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Frontend (Next.js) ───────────────────────────────────────
NEXT_PUBLIC_GRAPHQL_URL=http://localhost:8000/graphql
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── File Storage (Invoice PDFs, Images) ──────────────────────
STORAGE_BACKEND=local
# For S3/MinIO:
# STORAGE_BACKEND=s3
# S3_BUCKET_NAME=pharmacy-fantasy
# S3_ENDPOINT_URL=http://localhost:9000
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin

# ── GST Configuration ───────────────────────────────────────
DEFAULT_SGST_RATE=2.5
DEFAULT_CGST_RATE=2.5
COMPANY_GSTIN=19BKMPG6092H1ZO
COMPANY_NAME=MAA ESWARI PHARMACEUTICALS
COMPANY_ADDRESS=BENACHITY, DURGAPUR-13, WEST BENGAL
COMPANY_PHONE=9614081313
